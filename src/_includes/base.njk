{%- set L = languages[lang or "en"] -%}
{#- The Punjabi page also loads Gurmukhi faces that sit beside Cormorant and Mulish. -#}
{%- set fonts = "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Mulish:wght@400;500;600" + ("&family=Mukta+Mahee:wght@400;500;600&family=Tiro+Gurmukhi" if lang == "pa" else "") + "&display=swap" -%}
{%- if env.preview -%}
<title>Karan Boutique Website</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ fonts }}">
<style>
{% include "site.css" %}
</style>
<div lang="{{ L.htmlLang }}">
{{ content | safe }}
</div>
<script>
{% include "site.js" %}
</script>
{%- else -%}
<!doctype html>
<html lang="{{ L.htmlLang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{%- if site.url | isReal %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- endif %}
{%- if lang %}
{%- for code, l in languages %}
<link rel="alternate" hreflang="{{ l.htmlLang }}" href="{{ site.url }}{{ l.url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ languages.en.url }}">
{%- endif %}
<meta property="og:type" content="website">
<meta property="og:locale" content="{{ L.htmlLang | replace("-", "_") }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
{%- if site.url | isReal %}
<meta property="og:image" content="{{ site.url }}/og-image.png">
{%- endif %}
<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ fonts }}">
<style>
{% include "site.css" %}
</style>
{%- if schema %}
<script type="application/ld+json">
{% localBusinessSchema business, services, site %}
</script>
{%- endif %}
</head>
<body>
{{ content | safe }}
<script>
{% include "site.js" %}
</script>
</body>
</html>
{%- endif %}
