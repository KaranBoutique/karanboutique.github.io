{% macro icon(name) -%}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
{%- if name == "chat" %}
  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
{%- elif name == "phone" %}
  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
{%- elif name == "pin" %}
  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
{%- elif name == "clock" %}
  <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
{%- elif name == "instagram" %}
  <rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><path d="M17.5 6.5h.01"/>
{%- elif name == "facebook" %}
  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
{%- elif name == "star" %}
  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
{%- endif %}
</svg>
{%- endmacro %}

{# A button that links to another site, or a marked placeholder until the link is added. #}
{% macro linkbtn(url, label, iconName) -%}
{%- if url | isReal -%}
<a class="btn btn--line" href="{{ url }}" target="_blank" rel="noopener">{% if iconName %}{{ icon(iconName) }}{% endif %}<span>{{ label }}</span></a>
{%- else -%}
<span class="btn btn--line btn--todo" title="Link not added yet">{% if iconName %}{{ icon(iconName) }}{% endif %}<span>{{ label }}</span></span>
{%- endif -%}
{%- endmacro %}
